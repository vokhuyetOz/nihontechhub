    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "dc:up:dev": "docker compose up -d",
    "dc:down:dev": "docker compose down",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --detectOpenHandles --forceExit",
    "typeorm": "typeorm-ts-node-commonjs -d ormconfig.ts",
    "typeorm:create": "typeorm migration:create ./src/database/migrations/$npm_config_name",
    "typeorm:up": "npm run typeorm migration:run",
    "typeorm:down": "npm run typeorm migration:revert",
    "prepare": "husky install"
